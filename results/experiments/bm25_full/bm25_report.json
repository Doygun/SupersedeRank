  "config": {
    "bm25": {
      "implementation": "rank_bm25.BM25Okapi",
      "k1": 1.5,
      "b": 0.75,
      "epsilon": 0.25,
      "top_k": 50,
      "analyzer": {
        "lowercase": true,
        "tokenization": "split on whitespace and '/'; keep [a-z0-9.:@-] characters inside tokens; drop tokens shorter than 1",
        "punctuation": "stripped except '.', ':', '-', '@' (needed for CVE ids, metrics such as av:n, versions such as 3.1, source keys)"
      },
      "fields": {
        "identity": [
          "cve_id",
          "source_key",
          "cvss_version"
        ],
        "content": [
          "evidence_text"
        ]
      },
      "visibility": "observed_from <= query_time (documents activated after the query are never candidates)",
      "tie_break": {
        "method": "SHA256(seed | query_id | evidence_id), ascending",
        "seed": 20260918,
        "note": "evidence_id carries the chain sequence number, so plain evidence_id order would leak interval order"
      }
    },
    "full_run": {
      "main_splits": [
        "train",
        "dev",
        "test"
      ],
      "role": "POST_REPLACEMENT_MAIN",
      "output_dir": "results/experiments/bm25_full",
      "future_event": "run separately, descriptive only"
    },
    "oracle": {
      "current_first": [
        "TARGET_CURRENT",
        "OTHER_SOURCE_CURRENT",
        "TARGET_OUTDATED",
        "OTHER"
      ],
      "temporal": [
        "TARGET_CURRENT",
        "OTHER_SOURCE_CURRENT",
        "OTHER",
        "TARGET_OUTDATED"
      ],
      "note": "upper bounds over the BM25 top-k candidates; not model results"
    }
